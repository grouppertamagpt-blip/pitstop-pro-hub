# ==============================================================================
# AppBenk - Environment Variables Configuration Template
# ==============================================================================
# Salin file ini menjadi .env untuk pengembangan lokal (local development):
#   cp .env.example .env
#
# Untuk deployment ke Vercel / Netlify / Production Server:
# Masukkan seluruh variabel di bawah ini ke menu "Environment Variables" pada dashboard hosting.
# ==============================================================================

# --- SUPABASE CONFIGURATION (Wajib / Required) ---
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Service Role Key digunakan oleh server-side API (misal: endpoint undangan admin di src/server.ts)
# JANGAN PERNAH mengekspos kunci ini ke sisi browser / client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- DOMAIN & APPLICATION URL (Wajib untuk Production) ---
# Digunakan untuk pembuatan tautan undangan admin, webhook, dan pengalihan email/WhatsApp.
# Contoh local: http://localhost:8080
# Contoh Vercel: https://appbenk.vercel.app
VITE_APP_URL=https://your-production-domain.vercel.app
APP_URL=https://your-production-domain.vercel.app

# --- MIDTRANS PAYMENT GATEWAY (Opsional / Siap Pakai) ---
# Dapatkan dari Midtrans Dashboard -> Settings -> Access Keys
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-sample-key
VITE_MIDTRANS_SERVER_KEY=SB-Mid-server-sample-key
VITE_MIDTRANS_IS_PRODUCTION=false

# --- TWILIO WHATSAPP / SMS (Opsional) ---
# Dapatkan dari Twilio Console -> Account Info
VITE_TWILIO_ACCOUNT_SID=AC_sample_twilio_account_sid
VITE_TWILIO_AUTH_TOKEN=sample_twilio_auth_token
VITE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- GOOGLE MAPS API (Opsional) ---
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_sample_google_maps_api_key

# --- NITRO PRESET (Opsional / Otomatis Terdeteksi di Vercel & Netlify) ---
# Biarkan kosong atau tentukan jika ingin override manual ('vercel', 'netlify', 'node-server')
# NITRO_PRESET=vercel
